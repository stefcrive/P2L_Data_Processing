{
  "name": "irms-lab-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "dev": "npm run dev:web",
    "gen:types": "openapi-typescript http://localhost:8000/openapi.json -o packages/types/src/api.ts"
  }
}
